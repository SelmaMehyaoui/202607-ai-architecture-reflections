{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed model-tool composition response",
  "type": "object",
  "required": [
    "run_id",
    "task_id",
    "model_class",
    "model_id",
    "condition",
    "tool_selection_correct",
    "arguments_valid",
    "answer_correct",
    "clarification_correct",
    "abstention_correct",
    "unsupported_claim_count",
    "model_turns",
    "tool_calls",
    "end_to_end_ms"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "task_id": {"type": "string"},
    "model_class": {"enum": ["local", "remote"]},
    "model_id": {"type": "string"},
    "condition": {"enum": ["direct_context", "mcp"]},
    "tool_selection_correct": {"type": "boolean"},
    "arguments_valid": {"type": "boolean"},
    "answer_correct": {"type": "boolean"},
    "clarification_correct": {"type": "boolean"},
    "abstention_correct": {"type": "boolean"},
    "unsupported_claim_count": {"type": "integer", "minimum": 0},
    "model_turns": {"type": "integer", "minimum": 1},
    "tool_calls": {"type": "integer", "minimum": 0},
    "end_to_end_ms": {"type": "number", "minimum": 0},
    "inference_ms": {"type": ["number", "null"], "minimum": 0},
    "tool_ms": {"type": ["number", "null"], "minimum": 0},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "estimated_cost": {"type": ["number", "null"], "minimum": 0},
    "grader_notes": {"type": "string"}
  },
  "additionalProperties": false
}
