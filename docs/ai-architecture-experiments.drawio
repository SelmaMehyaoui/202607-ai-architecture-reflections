          <mxGeometry x="330" y="85" width="245" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="facts" value="Observed facts&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;specific process + configuration&lt;br&gt;specific outcome&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#EC4899;fontStyle=1;" vertex="1" parent="evidence-pipeline">
          <mxGeometry x="675" y="95" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="interpretation" value="Interpretation&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;qualified architectural inference&lt;br&gt;not a protocol guarantee&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="evidence-pipeline">
          <mxGeometry x="995" y="95" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="limitations" value="Limitations &amp; next experiments&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;model-driven selection is out of scope&lt;br&gt;remote MCP remains a future variant&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="evidence-pipeline">
          <mxGeometry x="1335" y="85" width="310" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="execute-record" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="evidence-pipeline" source="execute" target="record">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="record-facts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="evidence-pipeline" source="record" target="facts">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="facts-interpretation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="evidence-pipeline" source="facts" target="interpretation">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="interpretation-limitations" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="evidence-pipeline" source="interpretation" target="limitations">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="neutrality" value="Neutrality guardrail" style="swimlane;html=1;rounded=1;startSize=32;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=16;" vertex="1" parent="p2-1">
          <mxGeometry x="40" y="930" width="1720" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="neutrality-text" value="Do not pre-fill capability matrices • Do not claim “MCP is secure” • Do not claim skills inherently have broad access • Do not conflate model decisions with runtime authority • Measure before interpreting • Preserve failed and unavailable observations as limitations" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#7f1d1d;" vertex="1" parent="neutrality">
          <mxGeometry x="30" y="43" width="1660" height="50" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="model-tool-composition" name="3 — Model–Tool Composition">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" background="#F8FAFC" math="0" shadow="0">
      <root>
        <mxCell id="p3-0"/>
        <mxCell id="p3-1" parent="p3-0"/>
        <mxCell id="p3-title" value="Experiment 2 — Model Capability and Tool Composition" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#172554;fontFamily=Helvetica;align=left;" vertex="1" parent="p3-1">
          <mxGeometry x="40" y="20" width="1300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p3-question" value="Can a lightweight local model achieve non-inferior end-to-end task success when controlled knowledge and deterministic operations are exposed through the same MCP tools?" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FEF3C7;gradientColor=#FFF7ED;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontStyle=1;fontSize=16;opacity=96;shadow=1;" vertex="1" parent="p3-1">
          <mxGeometry x="40" y="85" width="1720" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="p3-local" value="Lightweight local model&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Pinned weights • quantization&lt;br&gt;Colima model runner • local resources&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FBCFE8;gradientColor=#FDF2F8;strokeColor=#DB2777;strokeWidth=1.5;fontColor=#831843;fontStyle=1;fontSize=17;opacity=96;shadow=1;" vertex="1" parent="p3-1">
          <mxGeometry x="80" y="230" width="300" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="p3-remote" value="Remote reference model&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Pinned snapshot where available&lt;br&gt;API tokens • cost • remote inference&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#BFDBFE;gradientColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#1E3A8A;fontStyle=1;fontSize=17;opacity=96;shadow=1;" vertex="1" parent="p3-1">
          <mxGeometry x="80" y="450" width="300" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="p3-direct" value="Direct-context condition&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Controlled orders + policies supplied in context&lt;br&gt;model retrieves, calculates, and answers&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#E9D5FF;gradientColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=1.5;fontColor=#581C87;fontStyle=1;fontSize=17;opacity=96;shadow=1;" vertex="1" parent="p3-1">
          <mxGeometry x="560" y="200" width="380" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="p3-mcp-condition" value="MCP-assisted condition&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Model translates intent and selects tools&lt;br&gt;MCP retrieves and calculates deterministically&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FED7AA;gradientColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontColor=#7C2D12;fontStyle=1;fontSize=17;opacity=96;shadow=1;" vertex="1" parent="p3-1">
          <mxGeometry x="560" y="450" width="380" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="p3-controlled-context" value="Identical synthetic Norvale domain&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;9 orders • 3 fictional categories • return policies&lt;br&gt;same facts, tasks, prompts, and answer criteria&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=16;" vertex="1" parent="p3-1">
          <mxGeometry x="1090" y="190" width="370" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p3-tools" value="Fixed typed MCP interface&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;summarize_orders(category?, date?)&lt;br&gt;get_return_policy(category)&lt;br&gt;structured results and errors&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFEDD5;gradientColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontColor=#7C2D12;fontStyle=1;fontSize=16;opacity=96;shadow=1;" vertex="1" parent="p3-1">
          <mxGeometry x="1090" y="440" width="370" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="p3-local-direct" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#EC4899;strokeWidth=2;" edge="1" parent="p3-1" source="p3-local" target="p3-direct">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p3-local-mcp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#EC4899;strokeWidth=2;" edge="1" parent="p3-1" source="p3-local" target="p3-mcp-condition">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p3-remote-direct" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="p3-1" source="p3-remote" target="p3-direct">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p3-remote-mcp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="p3-1" source="p3-remote" target="p3-mcp-condition">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p3-context-flow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="p3-1" source="p3-controlled-context" target="p3-direct">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p3-tool-flow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="p3-1" source="p3-tools" target="p3-mcp-condition">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p3-task-ladder" value="Controlled task ladder" style="swimlane;html=1;rounded=1;arcSize=14;startSize=35;fillColor=#E0E7FF;swimlaneFillColor=#EEF2FF;gradientColor=#F5F3FF;strokeColor=#6366F1;strokeWidth=1.5;fontColor=#312E81;fontStyle=1;fontSize=17;opacity=93;shadow=1;" vertex="1" parent="p3-1">
          <mxGeometry x="40" y="660" width="840" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="p3-task-text" value="1. Direct mapping → 2. Paraphrase → 3. Parameter extraction → 4. Multi-tool composition → 5. Ambiguity and clarification → 6. Structured-error recovery → 7. Correct tool abstention" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=20;fillColor=#ffffff;strokeColor=#666666;fontSize=15;" vertex="1" parent="p3-task-ladder">
          <mxGeometry x="35" y="70" width="770" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p3-evaluation" value="Evaluation and interpretation" style="swimlane;html=1;rounded=1;arcSize=14;startSize=35;fillColor=#F3E8FF;swimlaneFillColor=#FAF5FF;gradientColor=#FDF4FF;strokeColor=#9333EA;strokeWidth=1.5;fontColor=#581C87;fontStyle=1;fontSize=17;opacity=93;shadow=1;" vertex="1" parent="p3-1">
          <mxGeometry x="920" y="660" width="840" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="p3-primary" value="Primary endpoint&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;end-to-end task success&lt;br&gt;pre-registered non-inferiority margin&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#EC4899;fontStyle=1;fontSize=15;" vertex="1" parent="p3-evaluation">
          <mxGeometry x="35" y="70" width="230" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p3-secondary" value="Secondary evidence&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;tool validity • unsupported claims&lt;br&gt;latency • resources • tokens • cost&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="p3-evaluation">
          <mxGeometry x="300" y="70" width="230" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p3-claim" value="Bounded conclusion only&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;tests architectural substitution&lt;br&gt;does not claim general model equivalence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=15;" vertex="1" parent="p3-evaluation">
          <mxGeometry x="565" y="70" width="230" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p3-relationship" value="Relationship between experiments: Experiment 1 asks where selected actions execute and with what authority. Experiment 2 asks how much model capability is required above a fixed semantic tool boundary." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=15;" vertex="1" parent="p3-1">
          <mxGeometry x="40" y="970" width="1720" height="65" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
